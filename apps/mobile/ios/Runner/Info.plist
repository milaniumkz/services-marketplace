<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key><string>Приблизительное местоположение используется только для поиска услуг рядом. Можно выбрать город вручную.</string>
	<key>NSLocationDefaultAccuracyReduced</key><true/>
