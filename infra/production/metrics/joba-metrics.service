[Unit]
Description=JOBA host resource snapshot
[Service]
Type=oneshot
User=joba-metrics
Group=joba-metrics
ExecStart=/usr/bin/python3 /usr/local/lib/joba/collect-server-metrics.py --output-dir /var/lib/joba-metrics
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/joba-metrics
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
