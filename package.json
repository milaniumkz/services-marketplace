{
  "name": "services-marketplace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "services/api",
    "apps/admin",
    "packages/contracts",
    "apps/client",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @marketplace/api",
    "dev:api": "npm run dev --workspace @marketplace/api",
    "dev:admin": "npm run dev --workspace @marketplace/admin",
    "dev:client": "npm run dev --workspace @marketplace/client",
    "dev:web": "npm run dev --workspace @marketplace/web",
    "verify": "npm run build && node --test services/api/test/*.test.cjs",
    "seed:local": "JOBA_LOCAL_FIXTURES=1 node scripts/seed-local.cjs",
    "verify:postgres": "node scripts/verify-postgres.cjs",
    "verify:http": "node scripts/verify-http.cjs",
    "mobile:analyze": "node scripts/analyze-mobile.cjs",
    "mobile:test": "bash scripts/flutter-mobile.sh test --reporter expanded",
    "mobile:verify-api": "node scripts/verify-mobile-api.cjs",
    "mobile:build:android": "bash scripts/flutter-mobile.sh build apk --debug --dart-define=JOBA_API_URL=http://10.0.2.2:3000",
    "admin:verify-browser": "npm run build --workspace @marketplace/api && node scripts/verify-admin-browser.cjs",
    "verify:concurrency": "npm run build --workspace @marketplace/api && node scripts/verify-api-concurrency.cjs",
    "mobile:l10n": "node scripts/generate-mobile-localizations.cjs",
    "staff:bootstrap": "npm run build --workspace @marketplace/api && node scripts/bootstrap-staff.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
